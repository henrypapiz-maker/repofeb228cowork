{
  "version": 2,
  "crons": [
    {
      "path": "/api/agent-scan?key=${ADMIN_API_KEY}",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notify?type=daily&key=${ADMIN_API_KEY}",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/notify?type=weekly&key=${ADMIN_API_KEY}",
      "schedule": "0 14 * * 5"
    }
  ]
}
