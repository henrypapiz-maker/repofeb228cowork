{
  "name": "aliofoundry",
  "version": "1.0.0",
  "description": "AlioFoundry Intelligence Platform - Enterprise AI discovery and scoring",
  "main": "api/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch api/dev.js",
    "start": "node api/index.js",
    "test": "node --test api/**/*.test.js",
    "db:verify": "psql $DATABASE_URL -f db/schema/verify.sql",
    "db:init": "./db/scripts/init-neon.sh",
    "db:backup": "pg_dump $DATABASE_URL > db/backups/$(date +%Y%m%d-%H%M%S).sql",
    "deploy": "git push origin main"
  },
  "keywords": [
    "ai",
    "intelligence",
    "saas",
    "enterprise",
    "findings",
    "neon",
    "postgresql",
    "vercel"
  ],
  "author": "AlioFoundry",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "vercel": {
    "functions": {
      "api/**/*.js": {
        "runtime": "nodejs18.x",
        "memory": 3008,
        "maxDuration": 300
      }
    }
  }
}
